# ─── BikaSafe Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/bikasafe"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# For local dev use Ethereal (https://ethereal.email) - free fake SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="BikaSafe" <noreply@bikasafe.co.rw>

# ─── SMS — Africa's Talking ───────────────────────────────────────────────────
# Sign up at https://africastalking.com. Use 'sandbox' for dev.
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=
