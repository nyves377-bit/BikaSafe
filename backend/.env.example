# Database Configuration
# SQLite (local development)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — provided by Render)
# DATABASE_URL="postgresql://user:password@host:5432/bikasafe"

# JWT Secret — use a strong random string in production
JWT_SECRET=change_me_to_a_secure_random_string

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM='"BikaSafe Admin" <your_email@gmail.com>'

# BikaSafe Treasury Phone (for subscription payments)
BIKASAFE_TREASURY_PHONE=07XXXXXXXX

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Africa's Talking Configuration (SMS)
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here
AT_SENDER_ID=BIKASAFE
